# MediCall Backend — Environment Variables
# Copy to .env for local development

PORT=3000
NODE_ENV=development

# Public URL of this backend (used for Africa's Talking callbacks)
BASE_URL=http://localhost:3000

# --- Database ----------------------------------------------
# Neon PostgreSQL connection string
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-proud-moon-b56wisxg-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# --- CORS --------------------------------------------------
# URL of the Vercel frontend (set in production)
FRONTEND_URL=http://localhost:3001

# --- Africa's Talking --------------------------------------
AT_API_KEY=your_africastalking_api_key
AT_USERNAME=sandbox
AT_VOICE_PHONE_NUMBER=+233000000000
AT_SMS_SENDER_ID=medicall

# --- Khaya AI (Ghana NLP / Twi TTS) -----------------------
KHAYA_API_KEY=your_khaya_api_key
KHAYA_API_URL=https://translation-api.ghananlp.org/tts/v2/synthesize

# --- Groq AI -----------------------------------------------
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=gpt-oss-120B
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
ENABLE_AI_AGENT=true

# --- Cloudinary (Audio Storage) ----------------------------
CLOUDINARY_CLOUD_NAME=deplhwhk7
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- Call Retry Timing -------------------------------------
RETRY_NOT_TAKEN_MINUTES=30
RETRY_NO_ANSWER_MINUTES=120
COLLISION_BUFFER_MINUTES=60

