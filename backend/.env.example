# MediCall Backend Environment Variables

PORT=3000
NODE_ENV=production
BASE_URL=https://your-backend-domain.com

# Allowed Frontend Origins for CORS (comma-separated or single URL)
FRONTEND_URL=https://your-frontend-domain.com,http://localhost:3000,http://localhost:3001

# Database Configuration (Neon Serverless PostgreSQL or any Postgres)
# Leave empty to run in standalone offline SQLite mode
DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_PATH=./data/medicall.db

# Cloudinary CDN Storage for Pre-recorded Audio, Trailers & Prompts
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Africa's Talking Credentials (Live Production or Sandbox)
AT_API_KEY=your_africastalking_api_key
AT_USERNAME=your_at_username
AT_VOICE_PHONE_NUMBER=+233308048104
AT_SMS_SENDER_ID=medicall
PHARMACIST_PHONE=+233536287642

# Twi Speech Synthesis (TTS Engine: 'lab' or 'khaya')
TTS_PROVIDER=lab

# Lab Subscription Platform TTS
TTS_API_KEY=speech_live_your_token_here
TTS_API_URL=https://lab-subscription-platform.vercel.app/api/v1/tts

# Khaya AI (Ghana NLP) Credentials
KHAYA_API_KEY=your_khaya_api_key
KHAYA_TRANSLATE_URL=https://translation-api.ghananlp.org/v1/translate

# Groq AI Clinical Agent (Triages non-adherence & patient escalations)
ENABLE_AI_AGENT=true
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# Medication Schedule & Timing Rules
RETRY_NOT_TAKEN_MINUTES=30
RETRY_NO_ANSWER_MINUTES=120
COLLISION_BUFFER_MINUTES=60
