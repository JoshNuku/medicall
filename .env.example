# MediCall Backend Environment Variables

PORT=3000
BASE_URL=http://localhost:3000
AT_SMS_SENDER_ID=medicall

# Africa's Talking Credentials (Sandbox / Production)
AT_API_KEY=your_africastalking_api_key
AT_USERNAME=sandbox
AT_VOICE_PHONE_NUMBER=+233000000000

# Khaya AI (Ghana NLP) Credentials for Twi TTS
KHAYA_API_KEY=your_khaya_api_key
KHAYA_API_URL=https://translation-api.ghananlp.org/tts/v2/synthesize

# Database Path
DATABASE_PATH=./data/medicall.db

# Retry and Timing Configuration (optional overrides)
RETRY_NOT_TAKEN_MINUTES=30
RETRY_NO_ANSWER_MINUTES=120
COLLISION_BUFFER_MINUTES=60
